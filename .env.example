# ============================================
# Search-R1 Mini Configuration
# Copy this file to .env and fill in your values
# ============================================

# --- Paths ---
# Single root for everything downloaded or produced. Point it at a big disk
# to keep models + data + outputs out of the repo:
#     $SEARCH_ZERO_ROOT/models/    download_models.py output
#     $SEARCH_ZERO_ROOT/data/      wiki index, HotpotQA, SFT trajectories
#     $SEARCH_ZERO_ROOT/outputs/   SFT and GRPO checkpoints
# Unset -> the repo root (historical layout).
# SEARCH_ZERO_ROOT=/mnt/workspace

# Base model for SFT / GRPO / eval. Override to switch size, e.g.
#   BASE_MODEL=/mnt/workspace/models/Qwen2.5-3B-Instruct
# BASE_MODEL=

# --- LLM (OpenAI-compatible API) ---
# Works with: OpenAI, Qwen (DashScope), DeepSeek, vLLM, Ollama, etc.
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# --- Qwen / DashScope example ---
# LLM_API_KEY=sk-your-dashscope-key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# --- DeepSeek example ---
# LLM_API_KEY=sk-your-deepseek-key
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# --- Search Provider ---
# Options: duckduckgo (free, no API key) | tavily
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5

# --- Models ---
# Defaults resolve under $SEARCH_ZERO_ROOT/models (see download_models.py).
# Override with a HF repo id (BAAI/bge-small-en-v1.5) to use the HF cache instead.
EMBEDDING_MODEL=
RERANKER_MODEL=

# --- Agent ---
AGENT_MAX_STEPS=5
AGENT_TOP_K=3

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- SwanLab (experiment tracking) ---
# Get your key at https://swanlab.cn -> Settings -> API Key
SWANLAB_API_KEY=
# Optional: your SwanLab workspace/org. Leave empty to use your personal space.
SWANLAB_WORKSPACE=
# Project name shown in the SwanLab dashboard
SWANLAB_PROJECT=search-zero
# disabled = off | local = ./swanlog only, no upload | online = upload to cloud
# Leave empty: online when SWANLAB_API_KEY is set, otherwise local.
SWANLAB_MODE=
# Where local-mode runs are written
SWANLAB_LOGDIR=swanlog
# Optional display name for the run
SWANLAB_EXP_NAME=
